# Copy this file to `.env` in this folder and fill in your key:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The notebook loads this automatically via python-dotenv (load_dotenv()).

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
